# Host-side published port for the UI stack (docker compose variable
# substitution).
#
# This file is OPTIONAL. It is only needed for LOCAL OVERRIDES on a machine
# where the default host port (8080) is already taken. The stack runs fine
# with the default below without this file.
#
# IMPORTANT: ui/.env is read by Docker Compose for variable substitution in
# docker-compose.yml. It is unrelated to the API's src/api/.env (application
# configuration).
#
# To use: copy this file to ui/.env and adjust. ui/.env must NOT be committed
# (it is git-ignored).
#
# Changing this only changes where the UI is reachable from the HOST. The UI
# talks to the API by container name over the Docker network
# (https://products-api-nginx), so it depends on no API host port.

# UI nginx (container port 80)
UI_PORT=8080

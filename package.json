{
  "name": "products-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Plain HTML5/CSS3/ES-modules frontend for the Products API (PHP developer test assignment).",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
